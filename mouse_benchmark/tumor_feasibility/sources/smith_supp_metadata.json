{"files": [{"id": 40005507, "name": "23266066cir190155-sup-218256_2_supp_5706148_pw4wjc.xlsx", "size": 26226, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/40005507", "supplied_md5": "4198f39ee02249a15c0259d1a7cabdb8", "computed_md5": "4198f39ee02249a15c0259d1a7cabdb8", "mimetype": "undefined"}], "folder_structure": {}, "authors": [{"id": 4919620, "full_name": "Christof C. Smith", "first_name": "Christof C.", "last_name": "Smith", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3479885, "full_name": "Shengjie Chai", "first_name": "Shengjie", "last_name": "Chai", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15124116, "full_name": "Amber R. Washington", "first_name": "Amber R.", "last_name": "Washington", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-5454-4474"}, {"id": 15124119, "full_name": "Samuel J. Lee", "first_name": "Samuel J.", "last_name": "Lee", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2536-2684"}, {"id": 15017582, "full_name": "Elisa Landoni", "first_name": "Elisa", "last_name": "Landoni", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15124122, "full_name": "Kevin Field", "first_name": "Kevin", "last_name": "Field", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10970818, "full_name": "Jason Garness", "first_name": "Jason", "last_name": "Garness", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4919614, "full_name": "Lisa M. Bixby", "first_name": "Lisa M.", "last_name": "Bixby", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10204653, "full_name": "Sara R. Selitsky", "first_name": "Sara R.", "last_name": "Selitsky", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 15011781, "full_name": "Joel S. Parker", "first_name": "Joel S.", "last_name": "Parker", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-2080-6901"}, {"id": 839560, "full_name": "Barbara Savoldo", "first_name": "Barbara", "last_name": "Savoldo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2601241, "full_name": "Jonathan S. Serody", "first_name": "Jonathan S.", "last_name": "Serody", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 9143348, "full_name": "Benjamin G. Vincent", "first_name": "Benjamin G.", "last_name": "Vincent", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Current tumor neoantigen calling algorithms primarily rely on epitope/major histocompatibility complex (MHC) binding affinity predictions to rank and select for potential epitope targets. These algorithms do not predict for epitope immunogenicity using approaches modeled from tumor-specific antigen data. Here, we describe peptide-intrinsic biochemical features associated with neoantigen and minor histocompatibility mismatch antigen immunogenicity and present a gradient boosting algorithm for predicting tumor antigen immunogenicity. This algorithm was validated in two murine tumor models and demonstrated the capacity to select for therapeutically active antigens. Immune correlates of neoantigen immunogenicity were studied in a pan-cancer data set from The Cancer Genome Atlas and demonstrated an association between expression of immunogenic neoantigens and immunity in colon and lung adenocarcinomas. Lastly, we present evidence for expression of an out-of-frame neoantigen that was capable of driving antitumor cytotoxic T-cell responses. With the growing clinical importance of tumor vaccine therapies, our approach may allow for better selection of therapeutically relevant tumor-specific antigens, including nonclassic out-of-frame antigens capable of driving antitumor immunity.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/dataset/Supplemental_Data_File_1_from_Machine-Learning_Prediction_of_Tumor_Antigen_Immunogenicity_in_the_Selection_of_Therapeutic_Epitopes/22542117", "download_disabled": false, "description": "<p>Supplemental Data File</p>", "funding": "NIH", "funding_list": [{"id": 29591, "title": "NIH", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23221659, "title": "UNC University Cancer Research Fund", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 185063, "title": "Susan G. Komen", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 26226, "created_date": "2023-04-04T00:40:13Z", "modified_date": "2023-05-31T02:55:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Computational Methods", "Algorithms", "Molecular modeling", "Immunology", "Graft versus host disease", "Tumor antigens/neoantigens", "Immunotherapy", "Cancer vaccines", "Stem cell transplantation"], "keywords": ["Computational Methods", "Algorithms", "Molecular modeling", "Immunology", "Graft versus host disease", "Tumor antigens/neoantigens", "Immunotherapy", "Cancer vaccines", "Stem cell transplantation"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37363, "title": "Immuno-oncology", "parent_id": 0, "path": "/37363", "source_id": "", "taxonomy_id": 106}, {"id": 37375, "title": "Methods and Technology", "parent_id": 0, "path": "/37375", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/2326-6066.CIR-19-0155"], "has_linked_file": false, "citation": "Smith, Christof C.; Chai, Shengjie; Washington, Amber R.; Lee, Samuel J.; Landoni, Elisa; Field, Kevin; et al. (2019). Supplemental Data File 1 from Machine-Learning Prediction of Tumor Antigen Immunogenicity in t